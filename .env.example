# Copy to .env.local and fill in. Every variable here is required unless marked
# optional — the app has no silent fallbacks for them in production.

# --- Firebase (client SDK) -------------------------------------------------
# These are public by design: the Firebase web config ships in the JS bundle.
# Access is controlled by Firebase Auth rules and authorized-domain settings,
# not by keeping these secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Backend ---------------------------------------------------------------
# Base URL of the API backend. Server-only (no NEXT_PUBLIC_ prefix) so it is
# never exposed to the browser — all client calls go through /api/proxy.
# REQUIRED in production: the app throws rather than falling back to loopback.
API_URL=http://127.0.0.1:8000

# --- Sign in with Apple ----------------------------------------------------
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Must exactly match a Return URL registered in the Apple developer console.
NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000/api/auth/apple/callback

# --- Site ------------------------------------------------------------------
# Public origin (no trailing slash), used for canonical URLs in sitemap.xml
# and robots.txt. Both are prerendered, so this is read at BUILD time — it must
# be set in the hosting provider's project env vars too, or the deployed
# robots.txt/sitemap.xml will carry the localhost fallback.
NEXT_PUBLIC_SITE_URL=https://us-degree-web.vercel.app

# --- Client IP forwarding --------------------------------------------------
# Server-only (NOT NEXT_PUBLIC_). Signs the visitor IP that /api/proxy and SSR
# send as X-Client-IP so the backend can rate-limit per visitor. Must equal the
# backend PROXY_IP_SECRET. Carries the IP only; grants no data access. If unset,
# the headers are omitted and the backend sees one shared IP.
PROXY_IP_SECRET=
# Only for hosts other than Vercel (see lib/clientIp.ts): number of trusted
# proxies in front of the app that append to x-forwarded-for. Leave unset on Vercel.
TRUSTED_PROXY_HOPS=
