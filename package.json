  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build && node -e \"const fs=require('fs');fs.cpSync('public','.next/standalone/public',{recursive:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true})\"",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
